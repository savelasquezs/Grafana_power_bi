                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT ROUND(100.0 * SUM(lecturas_validas) / NULLIF(SUM(lecturas_totales), 0), 2) AS \"Datos válidos (%)\" FROM dwh.fact_energia_dia WHERE $__timeFilter(fecha_key::timestamp) AND dispositivo_key = ${dispositivo:raw}"
