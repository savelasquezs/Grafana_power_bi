                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT ts AS \"time\", p_ac_kw AS \"Potencia (kW)\", irradiancia_wm2 AS \"Irradiancia (W/m2)\" FROM silver.lectura_5min WHERE $__timeFilter(ts) AND dispositivo_key = ${dispositivo:raw} ORDER BY ts"
